{
  "name": "@steward/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows and Ubuntu owner portal for Steward",
  "author": {
    "name": "Ian Baer",
    "email": "iancbaer@users.noreply.github.com"
  },
  "homepage": "https://github.com/iancbaer/Nanshe",
  "desktopName": "steward.desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "lint": "node --check main.cjs && node --check preload.cjs"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.iancbaer.steward",
    "productName": "Steward",
    "executableName": "steward",
    "artifactName": "Steward-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
